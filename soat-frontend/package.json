{
  "name": "soat-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/checkEnvShadow.mjs",
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "test": "vitest run",
    "test:watch": "vitest",
    "tokens": "node scripts/checkTokens.mjs",
    "tokens:strict": "node scripts/checkTokens.mjs --strict",
    "guard:envshadow": "node scripts/checkEnvShadow.mjs",
    "guard:chain": "node scripts/checkChainCopy.mjs",
    "guard:env": "node scripts/checkPublicEnv.mjs",
    "guard:chainaddr": "node scripts/checkDeployedChain.mjs",
    "check:deployed": "node scripts/checkDeployedChain.mjs",
    "guard:rpc": "node scripts/checkServerRpc.mjs",
    "guard:supabase": "node scripts/checkSupabase.mjs",
    "check:upstash": "node scripts/checkUpstash.mjs",
    "check:supabase": "node scripts/checkSupabaseRls.mjs",
    "check:storage": "node scripts/checkSupabaseStorage.mjs",
    "check:sentry": "node scripts/checkSentry.mjs",
    "check:secrets": "node scripts/checkSecretStore.mjs",
    "check:pog": "node scripts/checkProdPogFlow.mjs",
    "check:blockscout": "node ../scripts/checkBlockscoutKey.mjs",
    "check:doc-symbols": "node ../scripts/checkDocSymbols.mjs",
    "guard:clmath": "node scripts/runTsGuard.mjs scripts/checkClMath.ts",
    "guard:lpactions": "node scripts/runTsGuard.mjs scripts/checkLpActions.ts",
    "guard:constants": "node scripts/runTsGuard.mjs scripts/checkContractConstants.ts",
    "guard:payable": "node scripts/runTsGuard.mjs scripts/checkPayableCalls.ts",
    "guard:walletchain": "node scripts/runTsGuard.mjs scripts/checkWalletChain.ts",
    "guard:quoteformat": "node scripts/runTsGuard.mjs scripts/checkQuoteFormat.ts",
    "guard:i18n": "node scripts/runTsGuard.mjs scripts/checkI18n.ts",
    "guard:guardcoverage": "node scripts/checkGuardCoverage.mjs",
    "check:quote": "node scripts/checkQuoteAsset.mjs",
    "guards": "npm run guard:envshadow && npm run guard:chain && npm run guard:env && npm run guard:chainaddr && npm run guard:rpc && npm run guard:supabase && npm run guard:clmath && npm run guard:lpactions && npm run guard:constants && npm run guard:payable && npm run guard:walletchain && npm run guard:quoteformat && npm run guard:i18n && npm run guard:guardcoverage",
    "verify": "node scripts/checkTokens.mjs --strict && tsc --noEmit && eslint && npm run guards && npm test && next build"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.71.0",
    "@supabase/supabase-js": "^2.105.4",
    "@tanstack/react-query": "^5.100.10",
    "lucide-react": "^1.14.0",
    "next": "^16.2.12",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hot-toast": "^2.6.0",
    "viem": "^2.48.11",
    "wagmi": "^3.6.14"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.2.12",
    "happy-dom": "^20.14.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "ws": "^8.21.3",
    "postcss": "^8.5.26",
    "sharp": "^0.35.3",
    "js-yaml": "^4.3.1",
    "nanoid": "^3.3.18",
    "@babel/core": "^7.29.7",
    "brace-expansion@<2": "^1.1.18",
    "brace-expansion@>=4": "^5.0.9"
  }
}
