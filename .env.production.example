# =============================================================================
# Tosh Fair Launchpad — PRODUCTION (MAINNET) Environment Template
# =============================================================================
# Copy this file to `.env.production` and fill in every value.
# DO NOT commit `.env.production` to git — `.gitignore` excludes it.
#
# Read `docs/INCIDENT_RESPONSE.md` and `docs/SECURITY_AUDIT.md` before deploying.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployer wallet (TEMPORARY ROLE)
# -----------------------------------------------------------------------------
# • This EOA is used ONLY for the initial `forge script DeployMainnet.s.sol`.
# • Immediately after deploy, ownership transfers (via Ownable2Step) to the
#   Gnosis Safe set in PROD_OWNER_SAFE.  This EOA loses all privileges once
#   the Safe calls `acceptOwnership()`.
# • Fund this address with ~0.05 ETH for the deploy + ownership-transfer
#   transactions, then NEVER use it again.
# -----------------------------------------------------------------------------
PRIVATE_KEY=0xREPLACE_ME_DEPLOYER_PRIVATE_KEY

# -----------------------------------------------------------------------------
# Target RPC (Ethereum mainnet, Base mainnet, etc.)
# Use a premium endpoint — public endpoints rate-limit deploys.
#
# The name matters. `foundry.toml`'s [rpc_endpoints] interpolates
# `${ROBINHOOD_RPC}` for the `robinhood` alias, so filling in only `TARGET_RPC`
# (as this template used to ask, back when the alias was `mainnet`) leaves
# `--rpc-url robinhood` resolving to an EMPTY string. Both names are given
# below: set them to the same endpoint. `TARGET_RPC` is kept because the
# runbooks pass it as a raw URL.
#
# The public endpoint is rate-limited with no archive guarantee or SLA. Fine for
# the deploy itself; use a dedicated provider for anything sustained.
# -----------------------------------------------------------------------------
ROBINHOOD_RPC=https://rpc.mainnet.chain.robinhood.com
TARGET_RPC=https://rpc.mainnet.chain.robinhood.com

# -----------------------------------------------------------------------------
# Chain the deploy is ALLOWED to land on. Required by DeployMainnet.s.sol.
#
# The cross-check on the RPC above, not a duplicate of it: the script compares
# `block.chainid` against this and refuses to broadcast on a mismatch, so a
# stale --rpc-url cannot quietly put a real fee-taking factory on the wrong
# chain. Change it in the same edit as the RPC.
#
#   4663  Robinhood Chain — the production target
#         (docs/ROBINHOOD_MIGRATION.md, superseding PM-B1)
#
# `vm.envUint` reverts on a missing variable before the script's friendly
# `require(targetChainId != 0)` can run, so omitting this yields a Foundry env
# error rather than a useful message.
# -----------------------------------------------------------------------------
TARGET_CHAIN_ID=4663

# -----------------------------------------------------------------------------
# Contract verification — no key required.
#
# Robinhood Chain is a Blockscout chain and Blockscout does not use API keys.
# Chain 4663 appears on neither Etherscan v2's multichain host nor Basescan, so
# the two key variables that used to live here have been deleted rather than
# left as REPLACE_ME lines an operator would dutifully fill in for nothing.
#
# Pass `--verifier blockscout` to forge; the URL comes from [etherscan] in
# foundry.toml.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Uniswap V4 PoolManager (target chain)
#
# Uniswap's own deployment on Robinhood Chain, and the same address on testnet
# 46630 — so this value does not change between a rehearsal and production.
# Cross-check against https://docs.uniswap.org/contracts/v4/deployments
# -----------------------------------------------------------------------------
V4_POOL_MANAGER=0x8366a39CC670B4001A1121B8F6A443A643e40951

# -----------------------------------------------------------------------------
# PoG oracle signer
# -----------------------------------------------------------------------------
# • On mainnet, this MUST be backed by a KMS / HSM (AWS KMS, GCP KMS, etc.).
#   The signer's private key never touches disk.  See `docs/SECURITY_AUDIT.md`
#   §Replay/Signature Hygiene for the threat model.
# • The address pasted here is the ADDRESS derived from the KMS-held key, not
#   the key itself.
# -----------------------------------------------------------------------------
POG_SIGNER_ADDRESS=0xREPLACE_ME_KMS_BACKED_SIGNER_ADDRESS

# -----------------------------------------------------------------------------
# Ladder treasury is deployed by DeployMainnet.s.sol (no SATO token).
# Paste the logged TREASURY_ADDRESS here after dry-run / broadcast.
# -----------------------------------------------------------------------------
LADDER_TREASURY_ADDRESS=0xREPLACE_ME_LADDER_TREASURY

# -----------------------------------------------------------------------------
# Platform treasury — LEGACY, RECEIVES NOTHING
# -----------------------------------------------------------------------------
# • A v4.x leftover.  In v5.0 the launch fee and the 1 % Phase-2 cut both go to
#   LADDER_TREASURY_ADDRESS and are burned, so this address is never paid.
# • It stays a required non-zero constructor argument only because it is the
#   sentinel filler in getLiveHookInitcodeHash().
# • A Safe is still the tidy choice, but there is no custody here to protect.
# -----------------------------------------------------------------------------
PLATFORM_TREASURY=0xREPLACE_ME_GNOSIS_SAFE_TREASURY

# -----------------------------------------------------------------------------
# Owner Gnosis Safe — receives ownership after the two-step transfer
# -----------------------------------------------------------------------------
# • MUST be different from the deployer (the script enforces this).
# • This Safe owns both the factory and the ladder treasury, so its signers
#   control the buyback ladder.  Separating it from PLATFORM_TREASURY buys
#   nothing now that PLATFORM_TREASURY holds no funds.
# • Signers MUST call `acceptOwnership()` from the Safe before announcing the
#   factory to users.  Until then, ownership is still with the deployer EOA.
# -----------------------------------------------------------------------------
PROD_OWNER_SAFE=0xREPLACE_ME_GNOSIS_SAFE_OWNER

# -----------------------------------------------------------------------------
# Post-deployment values (filled in AFTER `forge script DeployMainnet.s.sol`)
# -----------------------------------------------------------------------------
FACTORY_ADDRESS=0x
HOOK_CREATION_CODEHASH=0x
LIVE_INITCODE_HASH=0x
DEPLOY_BLOCK=0
