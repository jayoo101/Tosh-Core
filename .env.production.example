# =============================================================================
# Tosh Fair Launchpad — PRODUCTION (MAINNET) Environment Template
# =============================================================================
# Copy this file to `.env.production` and fill in every value.
# DO NOT commit `.env.production` to git — `.gitignore` excludes it.
#
# Read SECURITY.md before deploying. The live addresses and known residuals are there.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployer wallet (TEMPORARY ROLE)
# -----------------------------------------------------------------------------
# • This EOA is used ONLY for the initial `forge script DeployMainnet.s.sol`.
# • Immediately after deploy, ownership transfers (via Ownable2Step) to the
#   Gnosis Safe set in PROD_OWNER_SAFE.  This EOA loses all privileges once
#   the Safe calls `acceptOwnership()`.
# • Fund this address with ~0.0117 ETH (2x the measured C1 cost of ~0.005845 ETH
#   at 0.4009 gwei), then NEVER use it again. More is worse, not merely unused:
#   the key is in this file for as long as a deploy needs it, so the balance is
#   the exposure.
#
# Two names, and which one to keep:
#
#   DEPLOYER_ADDRESS  the address. This is all the checks need — preflight wanted
#                     the key only to compute `Wallet(pk).address`, which is a
#                     public value. Set this and leave it set.
#   PRIVATE_KEY       the key. Needed ONLY while `forge script --private-key` is
#                     actually being run. After the broadcast it is a liability
#                     with no remaining function: ownership has moved to
#                     PROD_OWNER_SAFE via Ownable2Step, so the EOA holds nothing
#                     but its residual balance. Sweep that balance and delete the
#                     line. `npm run check:secrets` inventories this name at tier
#                     `absent` and reports it until it is gone.
#
# Set both only on deploy day. They are compared when both are present, because
# the broadcast signs from the KEY while the checks would read the ADDRESS, and a
# disagreement means every check — including the one that prints "fund this
# address" — describes a wallet that never signs.
#
# The PoG signer section below has always worked this way: address here, key in
# the secret store. This block is now the same shape.
# -----------------------------------------------------------------------------
DEPLOYER_ADDRESS=0xREPLACE_ME_DEPLOYER_ADDRESS
# PRIVATE_KEY=0xREPLACE_ME_DEPLOYER_PRIVATE_KEY   # deploy day only, then delete

# -----------------------------------------------------------------------------
# Target RPC — BNB Smart Chain mainnet (56).
# Use a keyed endpoint. The public dataseed rate-limits deploys.
#
# The name matters. `foundry.toml`'s [rpc_endpoints] interpolates `${BSC_RPC}`
# for the `bsc` alias, so filling in only `TARGET_RPC` leaves `--rpc-url bsc`
# resolving to an EMPTY string. Both names are given below: set them to the same
# endpoint. `TARGET_RPC` is kept because the runbooks pass it as a raw URL.
#
# `BSC_RPC` is also what `scripts/preflightMainnet.mjs` reads for chain 56 and
# what the CI fork suite reads, so one endpoint answers for all three.
# -----------------------------------------------------------------------------
BSC_RPC=https://REPLACE_ME_PROVIDER/REPLACE_ME_KEY
TARGET_RPC=https://REPLACE_ME_PROVIDER/REPLACE_ME_KEY

# -----------------------------------------------------------------------------
# Chain the deploy is ALLOWED to land on. Required by DeployMainnet.s.sol.
#
# The cross-check on the RPC above, not a duplicate of it: the script compares
# `block.chainid` against this and refuses to broadcast on a mismatch, so a
# stale --rpc-url cannot quietly put a real fee-taking factory on the wrong
# chain. Change it in the same edit as the RPC.
#
#   56  BNB Smart Chain — the production target
#   97  BSC testnet — where the rehearsal ran
#
# `vm.envUint` reverts on a missing variable before the script's friendly
# `require(targetChainId != 0)` can run, so omitting this yields a Foundry env
# error rather than a useful message.
# -----------------------------------------------------------------------------
TARGET_CHAIN_ID=56

# -----------------------------------------------------------------------------
# Contract verification — one Etherscan v2 key covers both 56 and 97.
#
# This block said "no key required" for as long as the target was a Blockscout
# chain. Etherscan v2 serves 60+ chains from a single host and a single key,
# selected by a `chainid` parameter, and `foundry.toml`'s [etherscan] section has
# `bsc` and `bsc_testnet` entries pointing at it.
#
# Pass plain `--verify` to forge. Do NOT pass `--verifier blockscout`: Blockscout
# does not serve chain 56, and the flag is the one piece of the old instructions
# that would fail quietly by verifying nothing.
# -----------------------------------------------------------------------------
ETHERSCAN_API_KEY=REPLACE_ME_ETHERSCAN_V2_KEY

# -----------------------------------------------------------------------------
# PancakeSwap Infinity — CLPoolManager and Vault (target chain)
#
# ⚠ THESE ARE NOT INTERCHANGEABLE WITH UNISWAP V4, and this template shipped the
#   confusion: the variable was renamed to INFINITY_CL_POOL_MANAGER during the
#   port and kept Uniswap V4's PoolManager address on Robinhood Chain as its
#   value. That address has no code on either BSC chain, but the failure it
#   invites is worse than a revert — a manager that exists and is the wrong one
#   hashes every PoolKey to a pool the factory never opened.
#
#   `scripts/preflightMainnet.mjs` check 5b now asks the manager for its own
#   `vault()` and compares. Uniswap V4's singleton has no such function, because
#   it settles internally rather than through a Vault, so a V4 address fails
#   there by name. Run the preflight before broadcasting.
#
# Unlike the retired chain, mainnet and testnet do NOT share these addresses.
#
#   56  manager 0xa0FfB9c1CE1Fe56963B0321B32E7A0302114058b
#       vault   0x238a358808379702088667322f80aC48bAd5e6c4
#   97  manager 0x36A12c70c9Cf64f24E89ee132BF93Df2DCD199d4
#       vault   0x2CdB3EC82EE13d341Dc6E73637BE0Eab79cb79dD
#
# INFINITY_VAULT was absent from this template entirely while DeployMainnet.s.sol
# required it non-zero, so a deploy from a fully filled-in copy reverted.
# -----------------------------------------------------------------------------
INFINITY_CL_POOL_MANAGER=0xa0FfB9c1CE1Fe56963B0321B32E7A0302114058b
INFINITY_VAULT=0x238a358808379702088667322f80aC48bAd5e6c4

# -----------------------------------------------------------------------------
# PoG oracle signer
# -----------------------------------------------------------------------------
# • A NEW EOA, not the deployer above, and not any address that has been used
#   on testnet. A key that has signed on testnet is not a mainnet signer key.
# • Paste the ADDRESS here. The private key goes into Vercel Production as
#   POG_SIGNER_PRIVATE_KEY (encrypted) and is not written to this file.
# • KMS is not required. Revisit when more than one person can pull Production
#   secrets, or when an auditor requires the key never enter the process.
# -----------------------------------------------------------------------------
POG_SIGNER_ADDRESS=0xREPLACE_ME_POG_SIGNER_ADDRESS

# -----------------------------------------------------------------------------
# Ladder treasury is deployed by DeployMainnet.s.sol (no SATO token).
# Paste the logged TREASURY_ADDRESS here after dry-run / broadcast.
# -----------------------------------------------------------------------------
LADDER_TREASURY_ADDRESS=0xREPLACE_ME_LADDER_TREASURY

# -----------------------------------------------------------------------------
# Platform treasury — REAL REVENUE, AND YOU CANNOT CHANGE IT LATER
# -----------------------------------------------------------------------------
# • Receives 0.30 % of the ETH input of EVERY buy on every pool
#   (ToshLaunchpadHook.PLATFORM_SWAP_FEE_BPS).  This is carved OUT OF the
#   1.00 % swap tax, not added on top: the buyback reservoir still takes the
#   other 0.70 %, exactly as it did when the tax was a flat 0.70 %.
#   It is the platform's only income not committed to buyback-and-burn.
#   (This entry previously read "LEGACY, RECEIVES NOTHING".  That is now false.)
# • The sell leg is NOT split — token-side tax is burned in full — so this
#   address only ever receives ETH, never project tokens.
# • MUST BE A SAFE, or at minimum an address whose keys you are willing to
#   keep for the life of the deployment.
# • IMMUTABLE: `setPlatformTreasury` no longer exists (audit M-2), and the same
#   address is baked into the hook implementation as `platformFeeRecipient`.
#   Rotating it requires deploying a NEW FACTORY and migrating every pool.
#   Decide this before you broadcast.
# • MUST ACCEPT ETH UNCONDITIONALLY.  The hook pays it with `poolManager.take`,
#   a raw value transfer on a path that is NOT fault-isolated: a receive()
#   that can revert does not lose a fee, it bricks every buy on every pool.
#   A Gnosis Safe is fine — measured, not assumed: the real Safe's receive()
#   costs ~27.7k gas, far past the 2300 a bare transfer() would forward, and it
#   is payable only because v4-core uses call(gas(), …).  `ToshV5.t.sol` pins
#   both halves: a Safe-cost recipient is paid, and a REVERTING recipient bricks
#   every buy.  A proxy that can be paused, or anything with conditional
#   receive() logic, is therefore not fine.
# • Verify after deploy that it matches what the hook will actually pay:
#     factory.platformTreasury() ==
#       ToshLaunchpadHook(factory.hookImplementation()).platformFeeRecipient()
#   script/VerifyDeployment.s.sol asserts this; divergence is a money bug.
# -----------------------------------------------------------------------------
PLATFORM_TREASURY=0xREPLACE_ME_GNOSIS_SAFE_TREASURY

# -----------------------------------------------------------------------------
# Owner Gnosis Safe — receives ownership after the two-step transfer
# -----------------------------------------------------------------------------
# • MUST be different from the deployer (the script enforces this).
# • This Safe owns both the factory and the ladder treasury, so its signers
#   control the buyback ladder.
# • DECIDED (PM-C9, 2026-09-04): PLATFORM_TREASURY is the SAME Safe as this one.
#   An earlier note here argued for two separate Safes, on the reasoning that
#   the owner Safe holds admin powers and the treasury Safe holds revenue.  That
#   reasoning only pays off if the two signer SETS differ — and with three
#   signers total they cannot.  Anyone who compromises two of the three keys
#   reaches both Safes whether or not they are the same address, so a second
#   Safe would buy separation on paper and none in fact, at the cost of a second
#   address to fund, verify and get right at C1.
#   Revisit if the signer pool grows enough to staff two disjoint sets, or if
#   accrued revenue justifies a different custody posture than admin control.
# • The Safe itself exists as of 2026-09-04 — address in
#   SECURITY.md (the governance Safe), verifiable with
#   `node scripts/verifyOwnerSafe.mjs <addr>`.  It is deliberately not written
#   into this file: committed templates carry no values (see .gitignore).
# • Signers MUST call `acceptOwnership()` from the Safe before announcing the
#   factory to users.  Until then, ownership is still with the deployer EOA.
# -----------------------------------------------------------------------------
PROD_OWNER_SAFE=0xREPLACE_ME_GNOSIS_SAFE_OWNER

# -----------------------------------------------------------------------------
# Post-deployment values (filled in AFTER `forge script DeployMainnet.s.sol`)
# -----------------------------------------------------------------------------
FACTORY_ADDRESS=0x
HOOK_CREATION_CODEHASH=0x
LIVE_INITCODE_HASH=0x
DEPLOY_BLOCK=0
