# =============================================================================
# ToshX v2 -- PRODUCTION (chain 56) contract-side environment
# =============================================================================
# Copy to `.env.production` and fill in. DO NOT commit it; .gitignore excludes it.
# Read SECURITY.md before deploying.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployer (TEMPORARY ROLE). Used only to broadcast script/DeployV2.s.sol; the
# script refuses if it also holds PLATFORM_TREASURY or PROD_OWNER_SAFE. Fund it
# with only what the deploy costs, sweep the remainder afterwards, and delete
# the key line: `npm run check:secrets` reports PRIVATE_KEY until it is gone.
# -----------------------------------------------------------------------------
# PRIVATE_KEY=0xREPLACE_ME_DEPLOYER_PRIVATE_KEY   # deploy day only, then delete

# A keyed endpoint: the public dataseed rate-limits deploys. foundry.toml's
# `bsc` alias interpolates ${BSC_RPC}.
BSC_RPC=https://REPLACE_ME_PROVIDER/REPLACE_ME_KEY

TARGET_CHAIN_ID=56

ETHERSCAN_API_KEY=REPLACE_ME_ETHERSCAN_V2_KEY

INFINITY_CL_POOL_MANAGER=0xa0FfB9c1CE1Fe56963B0321B32E7A0302114058b
INFINITY_VAULT=0x238a358808379702088667322f80aC48bAd5e6c4

# -----------------------------------------------------------------------------
# Roles. On 56 DeployV2.s.sol asserts AGENT_REGISTRY, WBNB, USDT and
# FEE_RECIPIENT against the known mainnet addresses below, and requires
# PROD_OWNER_SAFE to be a 2-of-3 Safe. PLATFORM_TREASURY and FEE_RECIPIENT are
# immutable once deployed.
# -----------------------------------------------------------------------------
PLATFORM_TREASURY=0xREPLACE_ME_GNOSIS_SAFE_TREASURY
FEE_RECIPIENT=0x02DE4629129D104C63329D13A6Ca67E43db7B310
PROD_OWNER_SAFE=0xREPLACE_ME_GNOSIS_SAFE_OWNER
AGENT_REGISTRY=0x60B9262456dE011F7d15a54CdD8c48bAaa8B022F
WBNB=0xbb4CdB9CBd36B01bD1cBaEBF2De08d9173bc095c
USDT=0x55d398326f99059fF775485246999027B3197955

# Optional per-factory bounds; defaults are in the header of
# script/DeployV2.s.sol.
