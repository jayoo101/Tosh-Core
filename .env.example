# =============================================================================
# ToshX v2 -- contract-side environment (testnet defaults)
# =============================================================================
# Copy to .env and fill in. NEVER commit .env; .gitignore excludes it.
# `.env.production.example` is the chain-56 version of this file.
# =============================================================================

# Deployer. Holds no role once DeployV2.s.sol finishes.
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# -----------------------------------------------------------------------------
# RPC endpoints. BSC_RPC (56) is also read by the fork suites
# (test/v2/ForkV2Bsc.t.sol, test/ToshV5ForkInfinity.t.sol); unset, they report
# SKIPPED rather than failing. The public endpoints are rate-limited: point
# anything log-heavy at a keyed provider.
# -----------------------------------------------------------------------------
BSC_RPC=https://bsc-dataseed1.bnbchain.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# The chain the deploy is ALLOWED to land on: DeployV2.s.sol refuses when
# `block.chainid` differs, so a mistyped --rpc-url cannot deploy elsewhere.
TARGET_CHAIN_ID=97

# One Etherscan v2 key verifies on both 56 and 97 (foundry.toml [etherscan]).
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_V2_KEY

# -----------------------------------------------------------------------------
# PancakeSwap Infinity. DeployV2.s.sol asserts the manager reports this Vault.
#   56  manager 0xa0FfB9c1CE1Fe56963B0321B32E7A0302114058b
#       vault   0x238a358808379702088667322f80aC48bAd5e6c4
#   97  manager 0x36A12c70c9Cf64f24E89ee132BF93Df2DCD199d4
#       vault   0x2CdB3EC82EE13d341Dc6E73637BE0Eab79cb79dD
# -----------------------------------------------------------------------------
INFINITY_CL_POOL_MANAGER=0x36A12c70c9Cf64f24E89ee132BF93Df2DCD199d4
INFINITY_VAULT=0x2CdB3EC82EE13d341Dc6E73637BE0Eab79cb79dD

# -----------------------------------------------------------------------------
# Roles. PLATFORM_TREASURY (0.30 % swap cut, launch surplus) and FEE_RECIPIENT
# (bid-book fees) are IMMUTABLE once deployed. PROD_OWNER_SAFE receives factory
# and treasury ownership through Ownable2Step and must be a Safe, not the
# deployer.
# -----------------------------------------------------------------------------
PLATFORM_TREASURY=0xYOUR_TREASURY
FEE_RECIPIENT=0xYOUR_FEE_RECIPIENT
PROD_OWNER_SAFE=0xYOUR_GNOSIS_SAFE

# Agent ID registry. On 97, deploy the stand-in with
# script/DeployTestnetAgentRegistry.s.sol (owner: REGISTRY_OWNER).
AGENT_REGISTRY=0xYOUR_TESTNET_REGISTRY
REGISTRY_OWNER=0xYOUR_WALLET_ADDRESS

# Quote assets, both 18 decimals.
WBNB=0xYOUR_TESTNET_WBNB
USDT=0xYOUR_TESTNET_USDT

# Optional per-factory bounds; see the header of script/DeployV2.s.sol for the
# defaults (BNB_MIN_BUY, BNB_HARDCAP_MIN/MAX, BNB_AGENTCAP_MIN/MAX,
# BNB_TRIGGER_STEP and the USDT_* equivalents).

# DeployV31.s.sol only: the TOSH buyback's venues (it is the v3.1 ladder
# treasury and platform fee recipient, so PLATFORM_TREASURY is unused there).
# Optional bounds take a V31_ prefix; see the script header.
#   56  pair 0x16b9a82891338f9bA80E2D6970FddA79D1eb0daE  (PancakeSwap V2 USDT/WBNB)
#       feed 0x0567F2323251f0Aab15c8dFb1967E4e8A7D42aeE  (Chainlink BNB/USD)
#       hook 0x45F29984B980f3D076CD05e7BE72E3b357856bC8  ($TOSH)
USDT_WBNB_PAIR=0x
BNB_USD_FEED=0x
TOSH_HOOK=0x

# DeployLaunchGateway.s.sol only: the factory to put behind a new gateway.
FACTORY_ADDRESS=0x
