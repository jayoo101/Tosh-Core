# =============================================================================
# Tosh Fair Launchpad -- Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.  .gitignore already excludes it.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployer wallet
# BNB Smart Chain uses native BNB for gas. Testnet BNB comes from the BNB Chain
# faucet; mainnet BNB you buy.
# -----------------------------------------------------------------------------
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# -----------------------------------------------------------------------------
# RPC endpoints
#
# BSC_RPC is the production target (chain 56) and BSC_TESTNET_RPC (97) is where
# rehearsals run.
#
# The public endpoints below are rate-limited and carry no archive guarantee or
# SLA. They are fine for a deploy and for wallet traffic; point indexers and
# anything log-heavy at a dedicated provider. The watcher in particular is
# refused outright by the dataseed nodes on a 9,000-block `eth_getLogs` span.
#
# BSC_RPC does triple duty: the fork suites (test/ToshV5Fork.t.sol and
# test/ToshV5ForkInfinity.t.sol) read it for their live-Infinity assertions
# against chain 56, and `scripts/preflightMainnet.mjs` reads it for chain 56.
# Unset, the fork tests report SKIPPED rather than failing, so check the log
# before reading a green run as evidence they ran. CI treats a skip as a failure
# on the canonical repository for exactly that reason.
#
# No archive capability is needed: both fork suites are unpinned and each
# asserts `block.chainid == 56` itself, so a correct-looking endpoint for the
# wrong chain fails loudly rather than passing against another chain's AMM.
# -----------------------------------------------------------------------------
BSC_RPC=https://bsc-dataseed1.bnbchain.org
BSC_TESTNET_RPC=https://data-seed-prebsc-1-s1.bnbchain.org:8545

# -----------------------------------------------------------------------------
# Chain the deploy is ALLOWED to land on. Required by DeployMainnet.s.sol.
#
# This is not a duplicate of the RPC: it is the cross-check ON the RPC. Every
# other address below comes from this file, so a stale or mistyped --rpc-url
# would otherwise deploy a real, ownable, fee-taking factory onto the wrong
# chain, wired to that chain's non-existent CLPoolManager. The script compares
# `block.chainid` against this and refuses to broadcast on a mismatch.
#
# Set it to the chain you mean, and change it in the same edit as the RPC:
#   56  BNB Smart Chain -- production
#   97  BSC testnet -- staging rehearsals
#
# Note the failure mode if you leave it out. `vm.envUint` reverts on a missing
# variable BEFORE the friendly `require(targetChainId != 0)` can run, so the
# operator sees a Foundry env error rather than "TARGET_CHAIN_ID unset".
# -----------------------------------------------------------------------------
TARGET_CHAIN_ID=97

# -----------------------------------------------------------------------------
# Contract verification -- one Etherscan v2 key covers both 56 and 97.
#
# This block said "there is no key to set" for as long as the target was a
# Blockscout chain. Etherscan v2 serves 60+ chains from one host and one key,
# selected by a `chainid` parameter, and foundry.toml's [etherscan] section has
# `bsc` and `bsc_testnet` entries pointing at it.
#
# Pass plain `--verify`. Do NOT pass `--verifier blockscout`, which the old
# instructions in this block asked for: Blockscout does not serve chain 56 at
# any tier, so the flag verifies nothing and says so quietly.
# -----------------------------------------------------------------------------
ETHERSCAN_API_KEY=YOUR_ETHERSCAN_V2_KEY

# -----------------------------------------------------------------------------
# PancakeSwap Infinity -- CLPoolManager and Vault for the network you deploy to.
# Official list: https://developer.pancakeswap.finance/contracts/infinity/resources/addresses
#
# ⚠ THIS VARIABLE CARRIED UNISWAP V4'S ROBINHOOD POOLMANAGER until 2026-09-18.
#   It was renamed to INFINITY_CL_POOL_MANAGER during the port and never
#   revalued, so the name said Infinity and the address said Uniswap. It has no
#   code on either BSC chain, but the class of mistake is worse than a revert:
#   a manager that exists and is the wrong one hashes every PoolKey to a pool the
#   factory never opened, and nothing notices until the first deposit.
#
#   `scripts/preflightMainnet.mjs` check 5b now asks the manager for its own
#   `vault()` and compares it against INFINITY_VAULT. Uniswap V4 has no such
#   function -- it settles internally instead of through a Vault -- so a V4
#   address fails by name rather than by symptom.
#
# Unlike the retired chain, mainnet and testnet do NOT share these addresses, so
# a rehearsal does not exercise the production address book. That is the reason
# contracts.ts selects them by chain in source rather than reading them here.
#
#   56  manager 0xa0FfB9c1CE1Fe56963B0321B32E7A0302114058b
#       vault   0x238a358808379702088667322f80aC48bAd5e6c4
#   97  manager 0x36A12c70c9Cf64f24E89ee132BF93Df2DCD199d4
#       vault   0x2CdB3EC82EE13d341Dc6E73637BE0Eab79cb79dD
#
# Hooks are no longer CREATE2-mined against the manager. Infinity reads hook
# permissions from `getHooksRegistrationBitmap()`, so there is no salt to get
# wrong and no miner left in this repository.
# -----------------------------------------------------------------------------
INFINITY_CL_POOL_MANAGER=0x36A12c70c9Cf64f24E89ee132BF93Df2DCD199d4
INFINITY_VAULT=0x2CdB3EC82EE13d341Dc6E73637BE0Eab79cb79dD

# -----------------------------------------------------------------------------
# PoG oracle signer
# This address's private key is used by the backend to sign PoG gas attestations.
# On testnet: set to your deployer address so you can sign manually with cast.
# On mainnet: use a dedicated hot-wallet address (key lives on the backend server).
# -----------------------------------------------------------------------------
POG_SIGNER_ADDRESS=0xYOUR_WALLET_ADDRESS

# -----------------------------------------------------------------------------
# Platform treasury -- ON A MONEY PATH.  REQUIRED, AND UNROTATABLE.
#
# This used to say "legacy, receives nothing", and for one release it was true.
# It is not any more: this address receives 0.30 % of the quote-asset input of
# EVERY buy, on every pool (ToshLaunchpadHook.PLATFORM_SWAP_FEE_BPS, carved out
# of the 1.00 % swap tax; the other 0.70 % still goes to the buyback reservoir).
# It is the platform's only revenue that is not committed to buyback-and-burn.
# The cut is an ERC-20 transfer of the quote asset, not a native-coin send.
#
# There is NO DEFAULT any more.  The deploy scripts used to fall back to the
# deployer address, which was harmless while nothing was paid here and is not
# harmless now -- a forgotten env var would quietly pay the broadcasting key.
#
# IMMUTABLE.  `setPlatformTreasury` was deleted (audit finding M-2: a mutable
# fee-routing target lets the factory owner retarget live fee flows).  The same
# address is also baked into the hook implementation as `platformFeeRecipient`
# at construction.  Choose it BEFORE deploying: changing it means deploying a
# new factory.  A Safe is the right answer.
#
# A recipient that refuses native value no longer bricks buys: the cut is an
# ERC-20 transfer and does not call the recipient. A reverting `transfer` on
# the quote asset itself still would. A Safe is the right answer.
# -----------------------------------------------------------------------------
PLATFORM_TREASURY=0xYOUR_WALLET_ADDRESS

# -----------------------------------------------------------------------------
# Quote asset — the token every raise, fee, shelf price and buyback is in.
#
# REQUIRED by DeployMainnet.s.sol. On chain 56 this is BEM
# (0x5ce033B2bFCa3Af30b3e8C8457DeaF776A8b695a). On 97 BEM has no deployment, so
# this must be whatever 8-decimal token that factory was constructed against.
# The hook constructor asserts decimals() == 8 and refuses anything else.
# -----------------------------------------------------------------------------
QUOTE_ASSET=0x5ce033B2bFCa3Af30b3e8C8457DeaF776A8b695a

# Production owner Safe — MUST differ from the deployer EOA.
# DeployMainnet.s.sol queues Ownable2Step handover to this address.
PROD_OWNER_SAFE=0xYOUR_GNOSIS_SAFE

# =============================================================================
# Post-deployment: fill these in after running forge script
# =============================================================================
FACTORY_ADDRESS=0x
LADDER_TREASURY_ADDRESS=0x
