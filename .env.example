# =============================================================================
# Tosh Fair Launchpad -- Environment Variables
# =============================================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git.  .gitignore already excludes it.
# =============================================================================

# -----------------------------------------------------------------------------
# Deployer wallet
# Get Base Sepolia test ETH from: https://www.coinbase.com/faucets/base-ethereum-sepolia-faucet
# -----------------------------------------------------------------------------
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# -----------------------------------------------------------------------------
# RPC endpoints
# Free nodes: https://alchemy.com  |  https://infura.io  |  https://drpc.org
# -----------------------------------------------------------------------------
BASE_SEPOLIA_RPC=https://sepolia.base.org
BASE_MAINNET_RPC=https://mainnet.base.org

# -----------------------------------------------------------------------------
# Basescan API key (for --verify source verification)
# Get one free at: https://basescan.org/myapikey
# -----------------------------------------------------------------------------
BASESCAN_API_KEY=YOUR_BASESCAN_API_KEY

# -----------------------------------------------------------------------------
# Uniswap V4 PoolManager on Base Sepolia (chain 84532)
# Official list: https://docs.uniswap.org/contracts/v4/deployments
# Look up "Base Sepolia" in that table and copy the PoolManager address exactly.
# -----------------------------------------------------------------------------
V4_POOL_MANAGER=0xYOUR_V4_POOL_MANAGER_FROM_UNISWAP_DOCS

# -----------------------------------------------------------------------------
# PoG oracle signer
# This address's private key is used by the backend to sign PoG gas attestations.
# On testnet: set to your deployer address so you can sign manually with cast.
# On mainnet: use a dedicated hot-wallet address (key lives on the backend server).
# -----------------------------------------------------------------------------
POG_SIGNER_ADDRESS=0xYOUR_WALLET_ADDRESS

# -----------------------------------------------------------------------------
# Platform treasury -- LEGACY, RECEIVES NOTHING.
# A v4.x leftover.  In v5.0 the launch fee and the 1% Phase-2 cut both go to
# the ladder treasury and are burned, so this address is never paid.  It is
# still a required constructor argument (used as a build-fingerprint sentinel),
# so it must be non-zero, but do not treat it as fee custody.
# Deployer address is fine on any network.
# -----------------------------------------------------------------------------
PLATFORM_TREASURY=0xYOUR_WALLET_ADDRESS

# Production owner Safe — MUST differ from the deployer EOA.
# DeployMainnet.s.sol queues Ownable2Step handover to this address.
PROD_OWNER_SAFE=0xYOUR_GNOSIS_SAFE

# =============================================================================
# Post-deployment: fill these in after running forge script
# =============================================================================
FACTORY_ADDRESS=0x
LADDER_TREASURY_ADDRESS=0x
